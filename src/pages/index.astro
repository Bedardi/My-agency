---
import Layout from '../layouts/Layout.astro';
const posts = await Astro.glob('./posts/*.md');
---
<Layout title="Bedardi Bhai - Premium Web & App Developer" description="5+ years experienced developer building top-notch software.">
  
  <!-- HERO SECTION -->
  <section class="max-w-4xl mx-auto px-6 py-12 flex flex-col items-center text-center">
    
    <div class="inline-flex items-center space-x-2 bg-white border border-gray-200 px-4 py-2 rounded-full text-xs font-bold text-gray-600 mb-6 shadow-sm">
      <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
      <span>Accepting New Local Projects</span>
    </div>
    
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-app-dark leading-tight mb-6">
      Building Digital Assets That <br class="hidden md:block"/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-500">Scale Your Business</span>
    </h1>
    
    <p class="text-lg text-gray-600 max-w-2xl mb-10">
      Hi, I'm <strong>Bedardi Bhai</strong>, a full-stack developer with 5+ years of experience. I craft custom high-performance websites, mobile apps, and billing softwares.
    </p>
    
    <!-- Screenshot Style Buttons -->
    <div class="flex flex-col w-full sm:w-auto gap-4 sm:min-w-[350px]">
      <a href="tel:+917870692939" class="w-full bg-app-blue hover:bg-blue-700 text-white py-4 rounded-2xl font-bold shadow-md transition-transform active:scale-95 flex items-center justify-center text-lg">
        <i class="fas fa-phone-alt mr-3"></i> Call: +91 78706 92939
      </a>
      <a href="https://wa.me/917870692939" target="_blank" class="w-full bg-app-dark hover:bg-gray-900 text-white py-4 rounded-2xl font-bold shadow-md transition-transform active:scale-95 flex items-center justify-center text-lg">
        <i class="fab fa-whatsapp mr-3 text-green-400"></i> Discuss on WhatsApp &rarr;
      </a>
    </div>
  </section>

  <!-- SERVICES SECTION (With Gradient Borders) -->
  <section id="services" class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-10 text-app-dark">My Expertise</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Service Card 1 -->
        <div class="rounded-[1.25rem] p-[2px] bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-500 shadow-sm hover:shadow-md transition">
          <div class="bg-white p-8 rounded-[1.2rem] h-full flex flex-col items-start">
            <div class="w-12 h-12 bg-blue-50 text-app-blue rounded-xl flex items-center justify-center text-xl mb-4"><i class="fas fa-laptop-code"></i></div>
            <h3 class="text-xl font-bold mb-2 text-app-dark">Custom Web Apps</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Fast, SEO-optimized, and secure web applications tailored to streamline operations.</p>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div class="rounded-[1.25rem] p-[2px] bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 shadow-sm hover:shadow-md transition">
          <div class="bg-white p-8 rounded-[1.2rem] h-full flex flex-col items-start">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl mb-4"><i class="fas fa-mobile-alt"></i></div>
            <h3 class="text-xl font-bold mb-2 text-app-dark">Mobile Apps</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Cross-platform mobile apps with rich UI/UX for both Android and iOS devices.</p>
          </div>
        </div>

        <!-- Service Card 3 -->
        <div class="rounded-[1.25rem] p-[2px] bg-gradient-to-r from-purple-500 via-pink-500 to-orange-400 shadow-sm hover:shadow-md transition">
          <div class="bg-white p-8 rounded-[1.2rem] h-full flex flex-col items-start">
            <div class="w-12 h-12 bg-orange-50 text-orange-500 rounded-xl flex items-center justify-center text-xl mb-4"><i class="fas fa-store"></i></div>
            <h3 class="text-xl font-bold mb-2 text-app-dark">Billing Software</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Inventory management and POS systems specifically designed for local stores.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PROJECTS SECTION -->
  <section id="projects" class="py-16 max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-10 text-app-dark">Recent Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => (
        <div class="rounded-[1.25rem] p-[2px] bg-gradient-to-br from-gray-200 to-gray-300 hover:from-blue-400 hover:to-purple-500 transition-all duration-300">
          <a href={post.url} class="block bg-white p-8 rounded-[1.2rem] h-full">
            <span class="text-xs font-bold text-app-blue uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-md">{post.frontmatter.category || 'Case Study'}</span>
            <h3 class="text-2xl font-bold text-app-dark mt-4 mb-2">{post.frontmatter.title}</h3>
            <p class="text-gray-500 mb-6 line-clamp-2 text-sm">{post.frontmatter.description}</p>
            <div class="w-full bg-app-dark text-white py-3 rounded-xl font-bold text-center text-sm shadow-sm">
              Read Details &rarr;
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>
</Layout>
