---
import Layout from '../layouts/Layout.astro';
const posts = await Astro.glob('./posts/*.md');
---
<Layout title="Expert Web & App Development" description="5+ years experienced developer building top-notch software for local businesses.">
  
  <!-- HERO SECTION -->
  <section class="relative max-w-6xl mx-auto px-6 py-24 md:py-32 flex flex-col items-center text-center">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-100 via-transparent to-transparent -z-10 rounded-full blur-3xl opacity-50"></div>
    
    <div class="inline-flex items-center space-x-2 bg-white border border-gray-200 px-4 py-2 rounded-full text-xs font-bold text-gray-600 mb-8 shadow-sm">
      <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
      <span>Accepting New Local Projects</span>
    </div>
    
    <h1 class="text-5xl md:text-7xl font-black tracking-tight text-gray-900 leading-[1.1] mb-6">
      Building Digital Assets That <br class="hidden md:block"/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Scale Your Business.</span>
    </h1>
    
    <p class="text-lg md:text-xl text-gray-600 max-w-2xl mb-10 leading-relaxed">
      Hi, I'm a full-stack developer with 5+ years of experience. I craft custom high-performance websites, mobile apps, and billing softwares tailored for your specific needs.
    </p>
    
    <!-- Direct Contact CTA -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
      <a href="tel:+917870692939" class="w-full sm:w-auto bg-gray-900 hover:bg-gray-800 text-white px-8 py-4 rounded-2xl font-bold text-lg shadow-xl transition-transform active:scale-95 flex items-center justify-center">
        <i class="fas fa-phone-alt mr-3"></i> +91 98765 43210
      </a>
      <a href="https://wa.me/917870692939" target="_blank" class="w-full sm:w-auto bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-2xl font-bold text-lg shadow-xl shadow-green-500/20 transition-transform active:scale-95 flex items-center justify-center">
        <i class="fab fa-whatsapp text-xl mr-3"></i> Discuss on WhatsApp
      </a>
      <a href="mailto:support@mistahub.in" class="w-full sm:w-auto bg-white border border-gray-200 text-gray-800 hover:bg-gray-50 px-6 py-4 rounded-2xl font-bold text-lg shadow-sm transition-transform active:scale-95 flex items-center justify-center">
        <i class="fas fa-envelope text-blue-500"></i>
      </a>
    </div>
  </section>

  <!-- SERVICES SECTION -->
  <section id="services" class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-black text-center mb-12 text-gray-900">Expertise & Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fas fa-laptop-code"></i></div>
          <h3 class="text-xl font-bold mb-3">Custom Web Apps</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Fast, SEO-optimized, and highly secure web applications tailored to streamline your business operations.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fas fa-mobile-alt"></i></div>
          <h3 class="text-xl font-bold mb-3">Mobile Applications</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Cross-platform mobile apps with rich UI/UX that provide seamless experiences on both Android and iOS.</p>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition">
          <div class="w-14 h-14 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fas fa-store"></i></div>
          <h3 class="text-xl font-bold mb-3">Local Business Software</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Billing systems, inventory management, and CRM solutions specifically designed for local stores and agencies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS & BLOG SECTION (Auto-Generated) -->
  <section id="projects" class="py-24 max-w-6xl mx-auto px-6">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-2">Recent Work & Insights</h2>
        <p class="text-gray-500">Explore case studies of software I've built for clients.</p>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <a href={post.url} class="group block bg-white rounded-3xl border border-gray-200 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition duration-300">
          <div class="p-8">
            <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">{post.frontmatter.category}</span>
            <h3 class="text-2xl font-bold text-gray-900 mt-2 mb-3 group-hover:text-blue-600 transition">{post.frontmatter.title}</h3>
            <p class="text-gray-600 mb-6 line-clamp-2">{post.frontmatter.description}</p>
            <div class="flex items-center text-sm font-bold text-gray-900">
              Read Case Study <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition transform"></i>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
