---
const { title, description } = Astro.props;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Mistahub Agency</title>
    <meta name="description" content={description} />
    <!-- 100% Working CSS Fallback -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <!-- Navbar -->
    <nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 transition-all">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-black tracking-tighter text-gray-900">
          MistaHub<span class="text-blue-600">.Pro</span>
        </a>
        <div class="hidden md:flex space-x-6 font-semibold text-sm text-gray-600">
          <a href="#services" class="hover:text-blue-600 transition">Services</a>
          <a href="#projects" class="hover:text-blue-600 transition">Projects</a>
        </div>
        <a href="https://wa.me/917870692939" target="_blank" class="bg-green-500 hover:bg-green-600 text-white px-5 py-2 rounded-full font-bold text-sm shadow-lg shadow-green-500/30 transition-transform active:scale-95 flex items-center">
          <i class="fab fa-whatsapp mr-2"></i> WhatsApp
        </a>
      </div>
    </nav>
    
    <main class="min-h-screen pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12 border-t border-gray-800 text-center">
      <div class="max-w-4xl mx-auto px-6">
        <h3 class="text-2xl font-bold mb-6">Let's Build Something Great</h3>
        <div class="flex justify-center space-x-6 mb-8">
          <a href="tel:+917870692939" class="text-gray-400 hover:text-white transition" title="Call Me"><i class="fas fa-phone text-xl"></i></a>
          <a href="mailto:support@mistahub.in" class="text-gray-400 hover:text-white transition" title="Email Me"><i class="fas fa-envelope text-xl"></i></a>
          <a href="https://wa.me/917870692939" target="_blank" class="text-gray-400 hover:text-green-400 transition" title="WhatsApp"><i class="fab fa-whatsapp text-xl"></i></a>
          <a href="https://t.me/mistahub" target="_blank" class="text-gray-400 hover:text-blue-400 transition" title="Telegram"><i class="fab fa-telegram text-xl"></i></a>
        </div>
        <p class="text-sm text-gray-500">© 2026 Bedardi Bhai | MistaHub Pro. Serving Local & Global Clients.</p>
      </div>
    </footer>
  </body>
</html>
