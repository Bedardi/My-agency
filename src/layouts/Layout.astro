---
const { title, description } = Astro.props;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Mistahub Agency</title>
    <meta name="description" content={description} />
    
    <!-- Premium Rounded Font Matching Your Screenshot -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Fredoka', 'sans-serif'],
            },
            colors: {
              'app-blue': '#2a5ee8',
              'app-dark': '#1a1f36'
            }
          }
        }
      }
    </script>
    <style>
      body { background-color: #fafafa; }
    </style>
  </head>
  <body class="text-gray-800 font-sans antialiased">
    <!-- Navbar -->
    <nav class="fixed w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 transition-all shadow-sm">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold tracking-tight text-app-dark">
          MistaHub<span class="text-app-blue">.Pro</span>
        </a>
        <div class="hidden md:flex space-x-6 font-semibold text-gray-600">
          <a href="#services" class="hover:text-app-blue transition">Services</a>
          <a href="#projects" class="hover:text-app-blue transition">Projects</a>
        </div>
        <a href="https://wa.me/917870692939" target="_blank" class="bg-app-blue hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow-lg transition-transform active:scale-95 flex items-center">
          <i class="fab fa-whatsapp mr-2 text-lg"></i> WhatsApp
        </a>
      </div>
    </nav>
    
    <main class="min-h-screen pt-24 pb-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-app-dark text-white py-12 text-center mt-10 rounded-t-[3rem] mx-2">
      <div class="max-w-4xl mx-auto px-6">
        <h3 class="text-2xl font-bold mb-6">Let's Build Something Great</h3>
        <div class="flex justify-center space-x-6 mb-8">
          <a href="tel:+917870692939" class="text-gray-400 hover:text-white transition"><i class="fas fa-phone text-2xl"></i></a>
          <a href="mailto:support@mistahub.in" class="text-gray-400 hover:text-white transition"><i class="fas fa-envelope text-2xl"></i></a>
          <a href="https://wa.me/917870692939" target="_blank" class="text-gray-400 hover:text-green-400 transition"><i class="fab fa-whatsapp text-2xl"></i></a>
          <a href="https://t.me/mistahub" target="_blank" class="text-gray-400 hover:text-blue-400 transition"><i class="fab fa-telegram text-2xl"></i></a>
        </div>
        <p class="text-sm text-gray-400">© 2026 Bedardi Bhai | MistaHub Pro. Serving Local & Global Clients.</p>
      </div>
    </footer>
  </body>
</html>
