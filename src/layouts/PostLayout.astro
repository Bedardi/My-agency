---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <article class="max-w-3xl mx-auto px-6 py-20">
    <div class="mb-10 text-center">
      <span class="text-blue-600 font-bold text-sm uppercase tracking-wider">{frontmatter.category}</span>
      <h1 class="text-4xl md:text-5xl font-black mt-3 mb-4 text-gray-900 leading-tight">{frontmatter.title}</h1>
      <p class="text-gray-500">{frontmatter.date}</p>
    </div>
    
    <div class="prose prose-lg prose-blue mx-auto">
      <slot />
    </div>
    
    <!-- CTA for Blog Readers -->
    <div class="mt-16 p-8 bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 rounded-3xl text-center shadow-sm">
      <h3 class="text-2xl font-bold text-gray-900 mb-3">Need a similar solution for your business?</h3>
      <p class="text-gray-600 mb-6">Let's discuss your requirements and scale your operations.</p>
      <div class="flex justify-center space-x-4">
        <a href="tel:+917870692939" class="bg-gray-900 text-white px-6 py-3 rounded-xl font-bold hover:bg-gray-800 transition">Call Now</a>
        <a href="https://wa.me/917870692839" class="bg-green-500 text-white px-6 py-3 rounded-xl font-bold hover:bg-green-600 transition"><i class="fab fa-whatsapp mr-2"></i> Message</a>
      </div>
    </div>
  </article>
</Layout>
